{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    ":maintainLockFilesWeekly"
  ],
  "description": "Schedule dependency updates weekly on Saturday",
  "schedule": ["on saturday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["on saturday"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG YQ_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Keep PostgreSQL and coverage images pinned to manifest digests",
      "matchManagers": ["dockerfile"],
      "matchDepNames": ["postgres", "kcov/kcov"],
      "pinDigests": true
    },
    {
      "description": "Preserve the PostgreSQL major assigned to each build stage",
      "matchManagers": ["dockerfile"],
      "matchDepNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Group dependencies declared in Dockerfiles",
      "matchManagers": [
        "dockerfile",
        "custom.regex"
      ],
      "matchFileNames": [
        "Dockerfile"
      ],
      "groupName": "docker updates",
      "groupSlug": "docker-updates"
    },
    {
      "description": "Group images that ship in the published image; their updates are fixes that trigger a release",
      "matchManagers": [
        "dockerfile",
        "custom.regex"
      ],
      "matchFileNames": [
        "Dockerfile"
      ],
      "matchDepNames": [
        "postgres",
        "mikefarah/yq"
      ],
      "groupName": "runtime images",
      "groupSlug": "runtime-images",
      "semanticCommitType": "fix",
      "semanticCommitScope": "docker"
    },
    {
      "description": "Group Python development, documentation, and tooling dependencies; their updates do not trigger a release",
      "matchManagers": [
        "pep621"
      ],
      "groupName": "python updates",
      "groupSlug": "python-updates",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Group the Python dependencies that ship in the published image; their updates are fixes that trigger a release",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "project.dependencies"
      ],
      "groupName": "runtime dependencies",
      "groupSlug": "runtime-dependencies",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Group dependencies declared in GitHub Actions workflows",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions updates",
      "groupSlug": "github-actions-updates",
      "pinDigests": true
    }
  ]
}
